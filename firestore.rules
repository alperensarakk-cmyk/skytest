rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Güncelleme uyarısı (mağaza sürüm bilgisi — herkes okuyabilir)
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /sky_fight_challenges/{doc} {
      allow read: if true;
    }

    match /sky_fight_logs/{matchId} {
      allow write: if request.auth != null;
      match /answers/{doc} {
        allow write: if request.auth != null;
      }
    }

    match /matchmaking/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /matches/{matchId} {
      allow read, write: if request.auth != null;
      match /rounds/{roundId} {
        allow read, write: if request.auth != null;
      }
    }

    match /ghost_records/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /challenge_results/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && doc == request.resource.data.challengeId
                              + '__' + request.auth.uid;
      allow update, delete: if false;
    }

    // Günlük aktif kullanıcı sayacı (ana sayfa)
    match /daily_active/{day} {
      allow read: if true;
      allow create, update: if request.auth != null;
      match /users/{userId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

  }
}
